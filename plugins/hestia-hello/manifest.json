{
  "protocol": 1,
  "id": "hestia-hello",
  "name": "Hestia Hello",
  "version": "v0.3.0",
  "description": "Демонстрационный сервис whoami в Docker: отвечает приветствием по HTTP",
  "homepage": "https://github.com/uxerror/hestia",
  "author": {"name": "uxerror", "key": "v/i7jzbuZQGgOed7Q04PAQy3kj8U1gODTDdZdx2IXbo="},
  "min_hestia": "v0.3.0",
  "permissions": ["targets.read", "targets.exec", "deploy.docker", "net.outbound", "links.client"],
  "provides": [
    {"name": "web", "type": "http.service", "label": "Веб-страница", "client": true, "multi": true,
     "link_schema": {"fields": [
       {"name": "hostname", "type": "string", "label": "Имя", "default": "hello.home",
        "pattern": "^[a-z0-9.-]{1,63}$", "help": "Имя, по которому устройство найдёт сервис (запись в /etc/hosts)"}
     ]}}
  ],
  "requires": [],
  "multi_instance": true,
  "schema": {
    "fields": [
      {"name": "target", "type": "target", "label": "Где запустить", "required": true,
       "filter": {"docker_capable": true},
       "help": "Сервер или контейнер Proxmox с Debian/Ubuntu; Docker поставится, если его нет"},
      {"name": "port", "type": "int", "label": "Порт", "default": 8080, "min": 1, "max": 65535,
       "help": "Порт на цели, на котором whoami будет отвечать"},
      {"name": "message", "type": "string", "label": "Приветствие", "default": "Привет от Hestia",
       "max_len": 200}
    ],
    "presets": [
      {"name": "default", "label": "По умолчанию", "values": {}},
      {"name": "english", "label": "По-английски", "values": {"message": "Hello from Hestia"}}
    ]
  }
}
